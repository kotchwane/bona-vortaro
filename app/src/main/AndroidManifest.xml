<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          android:installLocation="auto">

  <!-- Every screen draws its own top bar with Compose, and follows the
       light/dark setting of the phone or of the app. The screens handle
       a change of this setting themselves (configChanges="uiMode"):
       Compose redraws them with the new colours, which is much faster than
       recreating them. -->
  <application android:name=".BonaApplication"
               android:label="@string/app_name"
               android:icon="@mipmap/ic_launcher"
               android:hardwareAccelerated="true"
               android:theme="@style/Theme.Bona"
               android:fullBackupContent="@xml/backup_rules"
               android:dataExtractionRules="@xml/data_extraction_rules">
    <activity android:name="LanguagesActivity"
              android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity android:name="SearchActivity"
              android:configChanges="uiMode"
              android:label="@string/search"
              android:exported="false" />
    <activity android:name="ArticleActivity"
              android:configChanges="uiMode"
              android:exported="false" />
    <activity android:name="SelectLanguageActivity"
              android:configChanges="uiMode"
              android:label="@string/my_search_languages"
              android:exported="false" />
    <activity android:name="PreferenceActivity"
              android:configChanges="uiMode"
              android:label="@string/preferences"
              android:exported="false" />
    <activity android:name="GuideActivity"
              android:configChanges="uiMode"
              android:exported="false" />
    <activity android:name="NameActivity"
              android:configChanges="uiMode"
              android:label="@string/name_title"
              android:exported="false" />
    <activity android:name="AdditionActivity"
              android:configChanges="uiMode"
              android:exported="false" />
    <activity android:name="OfficialityActivity"
              android:configChanges="uiMode"
              android:label="@string/officiality_title"
              android:exported="false" />
  </application>
</manifest>
